name:               lambda-calculus-tools

version:            0.1.0.0

license:            MIT

author:             sylambdacode

maintainer:         sy16367@163.com

build-type:         Simple

extra-doc-files:    CHANGELOG.md


common warnings
    ghc-options: -Wall


library
    import:           warnings

    exposed-modules:
        LambdaCalculusTools.UntypedLambdaCalculus.LambdaTerm,
        LambdaCalculusTools.UntypedLambdaCalculus.DeBruijnLambdaTerm,
        LambdaCalculusTools.SimpleTypedLambdaCalculus.SimpleType,
        LambdaCalculusTools.SimpleTypedLambdaCalculus.SimpleTypedLambdaTerm,
        LambdaCalculusTools.LambdaCube.LambdaCubeTerm,
        LambdaCalculusTools.UntypedLambdaCalculus.LambdaReduction,
        LambdaCalculusTools.LambdaCube.LambdaCubeReduction,
        LambdaCalculusTools.LambdaCube.LambdaCubeType,
        LambdaCalculusTools.UntypedLambdaCalculus.LambdaTermTools,
        LambdaCalculusTools.UntypedLambdaCalculus.KrivineMachine,
        LambdaCalculusTools.UntypedLambdaCalculus.LazyKrivineMachine,
        LambdaCalculusTools.LambdaParser.UntypedLambdaTokenParser,
        LambdaCalculusTools.LambdaParser.UntypedLambdaParser,
        LambdaCalculusTools.LambdaExtension.LambdaExtensionCalculatorException,
        LambdaCalculusTools.LambdaExtension.LambdaExtensionCalculator

    build-depends:
        base,
        containers,
        parsec,
        mtl

    hs-source-dirs:   src

    default-language: Haskell2010


executable lambda-calculus-tools-main
    import:           warnings

    main-is:          Main.hs

    other-modules:
        LambdaCalculusTools.CommandLineInterface.SimpleCalculatorSubcommand,
        LambdaCalculusTools.CommandLineInterface.SimpleKrivineMachineRunnerSubcommand,
        LambdaCalculusTools.CommandLineInterface.CommandException,
        LambdaCalculusTools.CommandLineInterface.CommandArg,

    build-depends:
        base,
        containers,
        mtl,
        lambda-calculus-tools

    hs-source-dirs:   app

    default-language: Haskell2010
