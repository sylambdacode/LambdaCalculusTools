{- use simplelang subcommand -}

main = cps {
    _ <- print "'Please input a integer:\n";
    _ <- main-loop 1000;
    _
};


main-loop = Y ^self. ^answer. ^cont. cps {
    stringvalue is-eof <- readline;
    if is-eof (print "'read EOF, exit.\n" (^_. cont answer))
    let number = string-to-int stringvalue; in
    if (eq number answer)
        cps {
            _ <- print "'That's right! The number is ";
            _ <- print (int-to-string answer);
            _ <- print "'!\n";
            cont answer
        }
        (if (int-lt number answer)
            cps {
                _ <- print "'Inputed number is less than the answer, please try again.\n";
                _ <- self answer;
                cont _
            }
            cps {
                _ <- print "'Inputed number is greater than the answer, please try again.\n";
                _ <- self answer;
                cont _
            })
};

Y = (λu x. x (u u x)) (λu x. x (u u x));
